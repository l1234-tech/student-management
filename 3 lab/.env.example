# В этом файле перечислены переменные окружения, которые нужны для запуска Spring Boot приложения.
# Скопируйте файл в .env и подставьте реальные значения локального окружения.

SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/student_management
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

SPRING_PROFILES_ACTIVE=dev
