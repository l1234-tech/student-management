# Пример конфигурации окружения для запуска приложения.
# Скопируйте файл в .env и заполните значения под своё окружение.
# Файл .env в репозиторий не попадает (исключён в .gitignore).

# --- Сервер ---
SERVER_PORT=8080

# --- Профиль приложения: dev | prod ---
SPRING_PROFILES_ACTIVE=dev

# --- База данных ---
# Значения по умолчанию в dev-профиле: H2 в памяти, пароль пустой.
# Для локального PostgreSQL раскомментируйте строки ниже.
# DB_URL=jdbc:postgresql://localhost:5432/student_management
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DRIVER=org.postgresql.Driver

# Если в dev используете PostgreSQL вместо H2, укажите платформу EclipseLink:
# ECLIPSELINK_TARGET_DATABASE=org.eclipse.persistence.platform.database.PostgreSQLPlatform

# В prod-профиле эти переменные обязательны:
# DB_URL=jdbc:postgresql://host:5432/student_management
# DB_USERNAME=prod_user
# DB_PASSWORD=prod_password
# DB_DRIVER=org.postgresql.Driver

# --- JWT ---
# Секреты обязаны быть не короче 32 символов (jjwt отклоняет короткие HMAC-ключи).
# В продакшене используйте длинные случайные строки, например: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-0123456789abcdefghijklmnop
JWT_REFRESH_SECRET=dev-refresh-secret-0123456789abcdefghijklmnopq
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
