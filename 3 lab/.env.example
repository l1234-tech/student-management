# Spring не загружает .env автоматически. Задайте переменные в терминале или запустите start.ps1.
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/student_management
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-db-password
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-your-own-password
# Разные ключи длиной не менее 32 байт. Если пусто, генерируются в data/*.key.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
