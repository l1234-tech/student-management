{
  "info": {
    "name": "Лабораторная 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "userUsername",
      "value": "postmanuser"
    },
    {
      "key": "userEmail",
      "value": "postman@example.com"
    },
    {
      "key": "userPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userAccessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Вход ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t=pm.response.json();",
              "pm.collectionVariables.set(\"accessToken\",t.accessToken);",
              "pm.collectionVariables.set(\"refreshToken\",t.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Создать студента",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/requests",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ISU\": 123456,\n  \"name\": \"Маша Иванова\",\n  \"group\": \"P1234\",\n  \"dormitory\": 5,\n  \"room\": 1234,\n  \"checkin_date\": \"2026-09-01\",\n  \"is_foreign\": false,\n  \"note\": \"Запись из Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Список и сортировка",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/requests?sort=ISU,asc&page=0&size=10",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Фильтрация",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/requests?group=P1234",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Поиск JSON",
      "request": {
        "method": "QUERY",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/requests",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group\": \"P1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Один студент",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/requests/123456",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/requests/123456",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"room\": 5678\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PUT",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/requests/123456",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ISU\": 123456,\n  \"name\": \"Маша Иванова\",\n  \"group\": \"P1234\",\n  \"dormitory\": 5,\n  \"room\": 4321,\n  \"checkin_date\": \"2026-09-01\",\n  \"is_foreign\": false,\n  \"note\": \"Запись из Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Обновить токены",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t=pm.response.json();",
              "pm.collectionVariables.set(\"accessToken\",t.accessToken);",
              "pm.collectionVariables.set(\"refreshToken\",t.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Регистрация USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t=pm.response.json();",
              "pm.collectionVariables.set(\"userAccessToken\",t.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "USER читает",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/requests",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "USER не создаёт",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/requests",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userAccessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ISU\": 123456,\n  \"name\": \"Маша Иванова\",\n  \"group\": \"P1234\",\n  \"dormitory\": 5,\n  \"room\": 1234,\n  \"checkin_date\": \"2026-09-01\",\n  \"is_foreign\": false,\n  \"note\": \"Запись из Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Удалить студента ADMIN",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/requests/123456",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Выход",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
